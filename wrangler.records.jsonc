{
  "name": "politics-records-refresh",
  "main": "workers/records-refresh.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "keep_vars": true,
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "COUNTY_DB",
      "database_name": "politics-county-snapshots",
